NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27018/luma?replicaSet=rs0&directConnection=true
PUBLIC_URL=http://127.0.0.1:4000
# Android WebSocket connections over adb reverse send the API origin.
CORS_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:4000
TRUST_PROXY_HOPS=0
# Generate independent random keys with npm run setup:env. These placeholders fail validation.
ACCESS_TOKEN_SECRET=CHANGE_ME_ACCESS_TOKEN_SECRET_32_RANDOM_BYTES
REFRESH_TOKEN_SECRET=CHANGE_ME_REFRESH_TOKEN_SECRET_32_RANDOM_BYTES
TOKEN_PEPPER=CHANGE_ME_TOKEN_PEPPER_32_RANDOM_BYTES
MEDIA_SIGNING_SECRET=CHANGE_ME_MEDIA_SIGNING_SECRET_32_RANDOM_BYTES
DEVICE_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARACTERS
METRICS_TOKEN=CHANGE_ME_METRICS_SECRET_32_RANDOM_BYTES
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
EMAIL_VERIFICATION=false
STORAGE=local
DATA_DIR=.data
MAX_UPLOAD_BYTES=20971520
RETENTION_DAYS=30
SCAN_MODE=disabled
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
INSTANCE_COUNT=1
LOG_LEVEL=info
# Optional single-instance Redis, mandatory when INSTANCE_COUNT > 1:
# REDIS_URL=redis://127.0.0.1:6381
# SMTP_HOST=smtp.your-domain.example
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=provided-via-secret-manager
MAIL_FROM=Luma <noreply@your-domain.example>
# For production use STORAGE=s3 and SCAN_MODE=clamav, SMTP, HTTPS PUBLIC_URL and metrics authentication.
# S3_BUCKET=your-private-chat-bucket
# S3_REGION=us-east-1
# S3_ENDPOINT=https://your-s3-compatible-endpoint.example
S3_FORCE_PATH_STYLE=false
# Supply AWS credentials through workload identity or standard AWS environment/credential configuration.
# Optional FCM push (credentials mounted read-only, never committed):
# FCM_PROJECT_ID=your-firebase-project-id
# FCM_CREDENTIALS_FILE=/run/secrets/fcm-service-account.json
